<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>ru.sbrf.ufs.dab2c.core.executor</groupId>
        <artifactId>deployments</artifactId>
        <version>1.0.0</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>router-executor</artifactId>
    <packaging>jar</packaging>
    <version>1.0.0</version>

    <build>
        <finalName>${deploymentUnit1}</finalName>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>ru.sbrf.ufs.dab2c.core.executor.deployments.router.executor.app.RouterExecutorApplicationEntryPointKt</mainClass>
                    <executable>true</executable>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <delimiters>
                        <delimeter>@</delimeter>
                    </delimiters>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <server.host>${server.host}</server.host>
                        <server.port>${server.port}</server.port>
                        <server.contextPath>${server.context.path1}</server.contextPath>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
                <filtering>true</filtering>
                <excludes>
                    <exclude>**/*.zip</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
                <includes>
                    <include>**/*.zip</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
                <filtering>true</filtering>
                <excludes>
                    <exclude>**/*.zip</exclude>
                </excludes>
            </testResource>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
                <includes>
                    <include>**/*.zip</include>
                </includes>
            </testResource>
        </testResources>
    </build>

    <dependencies>
        <!-- HealthCheck -->
        <dependency>
            <groupId>ru.sbrf.ufs.dab2c.core.executor</groupId>
            <artifactId>health-check</artifactId>
        </dependency>

        <!-- Commons -->
        <dependency>
            <groupId>ru.sbrf.ufs.dab2c.core.executor</groupId>
            <artifactId>commons</artifactId>
        </dependency>

        <!-- CBUL -->
        <dependency>
            <groupId>ru.sbrf.ufs.dab2c.core.executor</groupId>
            <artifactId>cbul-integration</artifactId>
        </dependency>

        <!-- Платформенное Ядро: Окружение -->
        <dependency>
            <groupId>ru.sbrf.ufs.platform</groupId>
            <artifactId>environment-spring-boot-starter</artifactId>
        </dependency>

        <!-- Кэш -->
        <dependency>
            <groupId>ru.sbrf.ufs.platform</groupId>
            <artifactId>ufs-platform-cache-impl</artifactId>
        </dependency>

        <!-- HttpClient -->
        <dependency>
            <groupId>ru.sbrf.ufs.platform</groupId>
            <artifactId>httpclient-spring-boot-starter</artifactId>
        </dependency>

        <!-- СУП -->
        <dependency>
            <groupId>ru.sbrf.ufs.platform</groupId>
            <artifactId>ufs-platform-config-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>ru.sbrf.ufs.platform</groupId>
            <artifactId>config-agent-spring-boot-starter</artifactId>
        </dependency>

        <!-- HotReload Secret -->
        <dependency>
            <groupId>ru.sbrf.ufs.app.hotreload</groupId>
            <artifactId>hotreload-spring-boot-starter</artifactId>
        </dependency>

        <!-- Журналирование -->
        <dependency>
            <groupId>ru.sbrf.ufs.platform</groupId>
            <artifactId>logger-springboot-starter</artifactId>
        </dependency>

        <!-- Мониторинг -->
        <dependency>
            <groupId>ru.sbrf.ufs.monitoring.spring-boot</groupId>
            <artifactId>monitoring-spring-boot-starter</artifactId>
        </dependency>

        <!-- Healthcheck / ЗоВО -->
        <dependency>
            <groupId>ru.sbrf.ufs.healthcheck</groupId>
            <artifactId>ufs-healthcheck-spring-boot-starter</artifactId>
        </dependency>

        <!-- Платформенное Ядро: RestApp -->
        <dependency>
            <groupId>ru.sbrf.ufs.platform</groupId>
            <artifactId>rest-app-jersey-spring-boot-starter</artifactId>
        </dependency>

        <!-- Schema validation -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.4.0</version>
        </dependency>
        <dependency>
            <groupId>ru.sbrf.ufs.dab2c.core.executor</groupId>
            <artifactId>test-utils</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ru.sbrf.ufs.dab2c.core.executor</groupId>
            <artifactId>monitoring</artifactId>
        </dependency>
        <!-- Resilience -->
        <dependency>
            <groupId>ru.sbrf.ufs.dab2c.core.executor</groupId>
            <artifactId>circuit-breaker</artifactId>
        </dependency>

        <dependency>
            <groupId>ru.sbrf.ufs.dab2c.core.executor</groupId>
            <artifactId>logging</artifactId>
        </dependency>

        <dependency>
            <groupId>ru.sbrf.ufs.dab2c.core.executor</groupId>
            <artifactId>concurrent</artifactId>
        </dependency>

        <dependency>
            <groupId>ru.sbrf.ufs.dab2c.core.executor</groupId>
            <artifactId>rest-object-mapper</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Профиль для плагина СУПа -->
        <profile>
            <id>build-config</id>
            <activation>
                <property>
                    <name>build-config</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>ru.sbrf.ufs.tool</groupId>
                        <artifactId>ufs-artifact-maven-plugin</artifactId>
                        <configuration>
                            <artifactPattern>(ru\.sbrf\..*|sber\.platform\..*)</artifactPattern>
                            <localFiles>
                                <file>${project.build.outputDirectory}/sup2/cbul.json</file>
                                <file>${project.build.outputDirectory}/sup2/sup.json</file>
                                <file>${project.build.outputDirectory}/sup2/parameters.json</file>
                                <file>${project.build.outputDirectory}/sup2/parameters.conf</file>
                            </localFiles>
                            <deploymentUnit>${deploymentUnit1}</deploymentUnit>
                            <scopeTemplate>${deploymentUnit1}_sup2_scopeTemplate</scopeTemplate>
                        </configuration>
                        <executions>
                            <execution>
                                <id>generate-sup-config</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>generate-ose-import-config-files</goal>
                                </goals>
                                <configuration>
                                    <configMapName>${config-fp-name1}-config-cm</configMapName>
                                    <configMapOutputDirectory>target/conf/k8s/base/configmaps</configMapOutputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Профиль для стационарной работы Spring Boot в STUB-режиме -->
        <profile>
            <id>server-stub-du1</id>
            <activation>
                <property>
                    <name>stand</name>
                    <value>local-stub-du1</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <fork>true</fork>
                            <profiles>
                                <profile>STUB</profile>
                                <profile>stubMode</profile> <!-- Нужно явно прописать для работы Мониторинга -->
                            </profiles>
                            <systemPropertyVariables>
                                <ru.sbrf.ufs.platform.envmode.dev>true</ru.sbrf.ufs.platform.envmode.dev>
                                <healthcheck.offline>true</healthcheck.offline>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <id>run-springboot-stub</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>build-distr</id>
            <activation>
                <property>
                    <name>build-distr</name>
                </property>
            </activation>

            <build>
                <plugins>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>ru.sbrf.ufs.zero-compress-plugin</groupId>
                        <artifactId>maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>re-compression</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
