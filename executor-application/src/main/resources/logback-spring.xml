<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Text console appender - used by ALL profiles -->
    <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} -%replace( [type=%X{type}]){'^ \[type=\]', ''}%replace( [traceId=%X{traceId}]){'^ \[traceId=\]', ''}%replace( [sessionId=%X{sessionId}]){'^ \[sessionId=\]', ''}%replace( [channel=%X{channel}]){'^ \[channel=\]', ''}%replace( [platform=%X{platform}]){'^ \[platform=\]', ''}%replace( [rqUid=%X{rqUid}]){'^ \[rqUid=\]', ''}%replace( [dest=%X{destinationSystem}%X{destinationService}]){'^ \[dest=\]', ''}%replace( [time=%X{executionTimeLong}ms]){'^ \[time=ms\]', ''}%replace( [status=%X{statusCode}]){'^ \[status=\]', ''}%replace( [error=%X{errorCode}]){'^ \[error=\]', ''}%replace( [rqMessage=%X{rqMessage}]){'^ \[rqMessage=\]', ''}%replace( [rsMessage=%X{rsMessage}]){'^ \[rsMessage=\]', ''} %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- PROM profile: Text to console + JSON to file -->
    <springProfile name="PROM">
        <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>/app/log/executor.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>/app/log/executor.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>7</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdc>true</includeMdc>
                <includeCallerData>false</includeCallerData>
                <fieldNames>
                    <timestamp>serverEventDatetime</timestamp>
                    <message>message</message>
                    <level>logLevel</level>
                    <version>[ignore]</version>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
                <timestampPattern>[UNIX_TIMESTAMP_AS_NUMBER]</timestampPattern>
                <customFields>{"serviceName":"dab2c-executor","tenantCode":"DAB2C"}</customFields>
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>30</maxDepthPerThrowable>
                    <maxLength>4096</maxLength>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_TEXT"/>
            <appender-ref ref="FILE_JSON"/>
        </root>
    </springProfile>

    <!-- Non-PROM profiles: Text to console only -->
    <springProfile name="!PROM">
        <root level="INFO">
            <appender-ref ref="CONSOLE_TEXT"/>
        </root>
    </springProfile>
</configuration>