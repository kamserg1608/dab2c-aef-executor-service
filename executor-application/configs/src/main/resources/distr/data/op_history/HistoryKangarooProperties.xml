#set( $symbol_pound = '#' )
#set( $symbol_dollar = '$' )
#set( $symbol_escape = '\' )
<?xml version="1.0" encoding="UTF-8"?>
<historyDocument xmlns="http://ufs.sbrf.ru/platform/history/history-entity-storage/v2"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://ufs.sbrf.ru/platform/history/history-entity-storage/v2
                  http://ufs.sbrf.ru/platform/history/history-entity-storage/v2">

    <!-- ОБЯЗАТЕЛЬНАЯ СЕКЦИЯ С ИНФОРМАЦИЕЙ О ДОКУМЕНТЕ -->
    <documentInfo>
        <!-- Тип заявки (строковое наименование уникальное для конкретного класса заявок) -->
        <documentType>UfsKangarooProperties</documentType>
        <!-- Русскоязычное название типа документа -->
        <documentDescription>Кенгуру, их все любят</documentDescription>
        <!-- КЭ владельца документа -->
        <CI>CI12008538</CI>
        <!-- Код подсистемы владельца документа -->
        <subSystem>ROUTER_EXECUTOR_JAVA_DAB2C</subSystem>
        <!-- Время жизни оперативных данных в днях (данные старше этого времени удаляются из БД ИО кеш) -->
        <cacheTTL>7</cacheTTL>
    </documentInfo>

    <!-- Секция с информацией о документе для ЕИО -->
    <uohDocumentInfo>
        <version>1</version>
        <operationStates>
            <operationState>EXECUTED</operationState>
            <stateDescription>Выполнено</stateDescription>
            <stateCategory>executed</stateCategory>
        </operationStates>
    </uohDocumentInfo>

</historyDocument>
