<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} -%replace( [type=%X{type}]){'^ \[type=\]', ''}%replace( [traceId=%X{traceId}]){'^ \[traceId=\]', ''}%replace( [sessionId=%X{sessionId}]){'^ \[sessionId=\]', ''}%replace( [channel=%X{channel}]){'^ \[channel=\]', ''}%replace( [platform=%X{platform}]){'^ \[platform=\]', ''}%replace( [rqUid=%X{rqUid}]){'^ \[rqUid=\]', ''}%replace( [dest=%X{destinationSystem}%X{destinationService}]){'^ \[dest=\]', ''}%replace( [time=%X{executionTimeLong}ms]){'^ \[time=ms\]', ''}%replace( [status=%X{statusCode}]){'^ \[status=\]', ''}%replace( [error=%X{errorCode}]){'^ \[error=\]', ''}%replace( [rqMessage=%X{rqMessage}]){'^ \[rqMessage=\]', ''}%replace( [rsMessage=%X{rsMessage}]){'^ \[rsMessage=\]', ''} %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/e2e-tests.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} -%replace( [type=%X{type}]){'^ \[type=\]', ''}%replace( [traceId=%X{traceId}]){'^ \[traceId=\]', ''}%replace( [sessionId=%X{sessionId}]){'^ \[sessionId=\]', ''}%replace( [channel=%X{channel}]){'^ \[channel=\]', ''}%replace( [platform=%X{platform}]){'^ \[platform=\]', ''}%replace( [rqUid=%X{rqUid}]){'^ \[rqUid=\]', ''}%replace( [dest=%X{destinationSystem}%X{destinationService}]){'^ \[dest=\]', ''}%replace( [time=%X{executionTimeLong}ms]){'^ \[time=ms\]', ''}%replace( [status=%X{statusCode}]){'^ \[status=\]', ''}%replace( [error=%X{errorCode}]){'^ \[error=\]', ''}%replace( [rqMessage=%X{rqMessage}]){'^ \[rqMessage=\]', ''}%replace( [rsMessage=%X{rsMessage}]){'^ \[rsMessage=\]', ''} %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Suppress noisy debug logs from JDK internals -->
    <logger name="java.lang.ProcessBuilder" level="INFO"/>

    <!-- Suppress noisy debug logs from ByteBuddy/Mockito agent attachment -->
    <logger name="net.bytebuddy" level="INFO"/>

    <!-- Suppress gRPC optional dependency warnings -->
    <logger name="io.grpc" level="INFO"/>
    <logger name="io.grpc.internal" level="WARN"/>
    <logger name="kafka" level="ERROR"/>
    <logger name="org.apache.zookeeper" level="ERROR"/>
    <logger name="org.apache.kafka" level="ERROR"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
