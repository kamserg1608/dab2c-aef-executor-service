<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <conversionRule conversionWord="presentMdc"
                    converterClass="ru.sbrf.dab2c.executor.application.logging.PresentMdcConverter"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ru.sbrf.dab2c.executor.application.logging.MaskingPatternLayout">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50}%presentMdc %msg%n</pattern>
        </layout>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/e2e-tests.log</file>
        <append>false</append>
        <layout class="ru.sbrf.dab2c.executor.application.logging.MaskingPatternLayout">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50}%presentMdc %msg%n</pattern>
        </layout>
    </appender>

    <appender name="FILE_JSON" class="ch.qos.logback.core.FileAppender">
        <file>logs/e2e-tests-json.log</file>
        <append>false</append>
        <encoder class="ru.sbrf.dab2c.executor.application.logging.MaskingLogstashEncoder">
            <includeMdc>true</includeMdc>
            <excludeMdcKeyName>__maskingValues</excludeMdcKeyName>
            <includeCallerData>false</includeCallerData>
            <fieldNames>
                <timestamp>serverEventDatetime</timestamp>
                <message>message</message>
                <level>logLevel</level>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <timestampPattern>[UNIX_TIMESTAMP_AS_NUMBER]</timestampPattern>
            <customFields>{"serviceName":"dab2c-executor","tenantCode":"DAB2C"}</customFields>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <maxLength>4096</maxLength>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- Suppress noisy debug logs from JDK internals -->
    <logger name="java.lang.ProcessBuilder" level="INFO"/>

    <!-- Suppress noisy debug logs from ByteBuddy/Mockito agent attachment -->
    <logger name="net.bytebuddy" level="INFO"/>

    <!-- Suppress gRPC optional dependency warnings -->
    <logger name="io.grpc" level="INFO"/>
    <logger name="io.grpc.internal" level="WARN"/>
    <logger name="kafka" level="ERROR"/>
    <logger name="org.apache.zookeeper" level="ERROR"/>
    <logger name="org.apache.kafka" level="ERROR"/>
    <logger name="state.change.logger" level="ERROR"/>
    <logger name="org.wiremock" level="WARN"/>
    <logger name="WireMock" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="FILE_JSON"/>
    </root>

</configuration>
