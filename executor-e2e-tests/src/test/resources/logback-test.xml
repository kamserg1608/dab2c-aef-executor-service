<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <conversionRule conversionWord="presentMdc"
                    converterClass="ru.sbrf.dab2c.executor.application.logging.PresentMdcConverter"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50}%presentMdc %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/e2e-tests.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50}%presentMdc %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Suppress noisy debug logs from JDK internals -->
    <logger name="java.lang.ProcessBuilder" level="INFO"/>

    <!-- Suppress noisy debug logs from ByteBuddy/Mockito agent attachment -->
    <logger name="net.bytebuddy" level="INFO"/>

    <!-- Suppress gRPC optional dependency warnings -->
    <logger name="io.grpc" level="INFO"/>
    <logger name="io.grpc.internal" level="WARN"/>
    <logger name="kafka" level="ERROR"/>
    <logger name="org.apache.zookeeper" level="ERROR"/>
    <logger name="org.apache.kafka" level="ERROR"/>
    <logger name="state.change.logger" level="ERROR"/>
    <logger name="org.wiremock" level="WARN"/>
    <logger name="WireMock" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
