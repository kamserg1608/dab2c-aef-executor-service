{
  "output": {
    "filePath": "repomix-output.md",
    "style": "markdown",
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true
  },
  "include": [
    "**/src/main/java/**",
    "**/src/main/kotlin/**",
    "**/src/main/resources/**",

    "**/src/test/java/**",
    "**/src/test/kotlin/**",
    "**/src/test/resources/**",

    "**/build/generated/openapi/src/main/**/model/**",
    "**/generated/openapi/src/main/**/model/**",

    "pom.xml",
    "**/pom.xml",

    "build.gradle",
    "**/build.gradle",

    "build.gradle.kts",
    "**/build.gradle.kts",

    "settings.gradle",
    "**/settings.gradle",

    "settings.gradle.kts",
    "**/settings.gradle.kts",

    "gradle.properties",
    "**/gradle.properties",

    "buildSrc/**",

    "config/**",

    "**/application.yml",
    "**/application.yaml",
    "**/application.properties",

    "**/bootstrap.yml",
    "**/bootstrap.yaml",
    "**/bootstrap.properties",

    "**/logback.xml",
    "**/logback-*.xml",

    "**/openapi/**",
    "**/openapi*.yml",
    "**/openapi*.yaml",

    "**/swagger*.yml",
    "**/swagger*.yaml",

    "**/db/changelog/**",
    "**/liquibase/**",

    "**/*.proto",

    ".editorconfig",
    "**/.editorconfig",

    "README.md",
    "**/README.md",

    "CONTRIBUTING.md",
    "**/CONTRIBUTING.md"
  ],
  "ignore": {
    "customPatterns": [
      "**/target/**",

      "**/build/**",
      "!**/build/generated/",
      "!**/build/generated/openapi/",
      "!**/build/generated/openapi/src/",
      "!**/build/generated/openapi/src/main/",
      "!**/build/generated/openapi/src/main/**/",
      "!**/build/generated/openapi/src/main/**/model/**",

      "**/.gradle/**",
      "**/.mvn/**",
      "**/.idea/**",
      "**/.settings/**",
      "**/.kotlin/**",
      "**/.git/**",
      "**/.github/**",

      "**/node_modules/**",

      "**/out/**",
      "**/dist/**",

      "**/generated/**",
      "!**/generated/openapi/",
      "!**/generated/openapi/src/",
      "!**/generated/openapi/src/main/",
      "!**/generated/openapi/src/main/**/",
      "!**/generated/openapi/src/main/**/model/**",

      "**/generated-sources/**",
      "**/generated-test-sources/**",

      "**/*.class",
      "**/*.jar",
      "**/*.war",
      "**/*.ear",
      "**/*.iml",

      "**/*.log",
      "**/logs/**",
      "**/tmp/**",

      "**/coverage/**",
      "**/.cache/**",
      "**/.scannerwork/**",

      "**/.DS_Store"
    ]
  }
}